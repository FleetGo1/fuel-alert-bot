# Copy this file to ".env" (for running on a PC). On GitHub, put these in
# Settings > Secrets and variables > Actions instead. Never share the real values.

# Where truck data comes from: fleetgo (website login, no API needed) or motive (API key)
DATA_SOURCE=fleetgo

# FleetGO login the bot uses (best: a separate account just for the bot)
FLEETGO_EMAIL=
FLEETGO_PASSWORD=
# FleetGO website address and the company to select (ask the bot's maintainer)
FLEETGO_URL=
FLEETGO_COMPANY_ID=

# Only if DATA_SOURCE=motive: Motive Admin > Developer API
MOTIVE_API_KEY=

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Run: python fuel_alert_bot.py --get-chat-id   (group ids start with -100...)
TELEGRAM_CHAT_ID=

# Who gets tagged at 30% and 25% (Telegram usernames, space separated)
MONITOR_TAGS=@your_monitoring_username

# Levels (percent)
WATCH_PERCENT=40
TAG_PERCENT=30
CRITICAL_PERCENT=25
RESET_PERCENT=50
# Repeat the URGENT alert every N minutes while a truck stays at 25% or less
REMIND_MINUTES=60
# Ignore trucks whose GPS/fuel data is older than this
STALE_HOURS=3
CHECK_EVERY_MINUTES=5

FUEL_CARD_CHAINS=TA, Love's, Pilot, Flying J
# Black states (never fuel there)
NEVER_FUEL_STATES=CA,MA,NH,OR,WA
# Warn "fuel before entering" when the next stop is in a black state, the truck is in a
# neighboring state (or this close to the stop) and fuel is below the minimum
BLACK_MIN_FUEL_PERCENT=85
BLACK_WARN_MILES=300
BLACK_REMIND_MINUTES=60
BLACK_REMINDERS=2

# Driver types that get fuel alerts, read from the group name: (C/D) (O/O) (L/O)
FUEL_ALERT_TYPES=C/D
# Groups with no type in the name: 1 = still alert, 0 = skip
ALERT_UNKNOWN_TYPE=1

# Possible fuel theft: alert when fuel drops this many % points MORE than driving explains
THEFT_DROP_PERCENT=10
# 1 = wait for one more reading to confirm (avoids sensor-glitch false alarms)
THEFT_CONFIRM=1
# Trucks to skip, e.g. in the shop
IGNORE_UNITS=

# High-value loads (bot reads the drivers' Telegram groups)
READ_DRIVER_GROUPS=1
# Where alerts go:
#   central       = all fuel/black-state/theft alerts to ONE fuel group; driver groups only get HV loads
#   driver_groups = one message in the driver's group; monitoring team (member there) gets tagged
#   separate      = tagged alert to TELEGRAM_CHAT_ID (monitoring group) + plain message to driver group
ALERT_MODE=central
# Fuel group for central mode (empty = use TELEGRAM_CHAT_ID)
FUEL_ALERT_CHAT_ID=
# After a fuel alert, stay quiet about that truck for this many hours
ALERT_COOLDOWN_HOURS=5
# separate mode only: also post the plain message in the driver's group (1 = yes)
DRIVER_ALERTS=1
HV_MIN_FUEL_PERCENT=75
HV_NONSTOP_MILES=300
HV_NEAR_SHIPPER_MILES=60
TANK_GALLONS=150
# Used until each truck's own MPG is learned from its data
MPG=6.5
# Low end of the range = this much of normal MPG (hills, heavy load)
HARD_ROAD_FACTOR=0.85
# Learn a truck's MPG after it has burned at least this many gallons
MPG_MIN_GALLONS=30
RESERVE_PERCENT=10
# Truck counts as "stopped" if it moves less than this between 2 checks (~10 min)
STOP_MOVE_MILES=0.3
STOP_CHECKS=2
