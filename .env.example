# Copy this file to ".env" (for running on a PC). On GitHub, put these in
# Settings > Secrets and variables > Actions instead. Never share the real values.

# Where truck data comes from: fleetgo (website login, no API needed) or motive (API key)
DATA_SOURCE=fleetgo

# FleetGO login the bot uses (best: a separate account just for the bot)
FLEETGO_EMAIL=
FLEETGO_PASSWORD=
# FleetGO website address and the company to select (ask the bot's maintainer)
FLEETGO_URL=
FLEETGO_COMPANY_ID=

# Only if DATA_SOURCE=motive: Motive Admin > Developer API
MOTIVE_API_KEY=

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Run: python fuel_alert_bot.py --get-chat-id   (group ids start with -100...)
TELEGRAM_CHAT_ID=

# Who gets tagged at 30% and 25% (Telegram usernames, space separated)
MONITOR_TAGS=@your_monitoring_username

# Levels (percent)
WATCH_PERCENT=40
TAG_PERCENT=30
CRITICAL_PERCENT=25
RESET_PERCENT=50
# Repeat the URGENT alert every N minutes while a truck stays at 25% or less
REMIND_MINUTES=60
# Ignore trucks whose GPS/fuel data is older than this
STALE_HOURS=3
CHECK_EVERY_MINUTES=5

FUEL_CARD_CHAINS=TA, Love's, Pilot, Flying J
NEVER_FUEL_STATES=CA,MA,NH,OR,WA
# Trucks to skip, e.g. in the shop
IGNORE_UNITS=

# High-value loads (bot reads the drivers' Telegram groups)
READ_DRIVER_GROUPS=1
# Where alerts go:
#   driver_groups = one message in the driver's group; monitoring team (member there) gets tagged
#   separate      = tagged alert to TELEGRAM_CHAT_ID (monitoring group) + plain message to driver group
ALERT_MODE=driver_groups
# separate mode only: also post the plain message in the driver's group (1 = yes)
DRIVER_ALERTS=1
HV_MIN_FUEL_PERCENT=75
HV_NONSTOP_MILES=300
HV_NEAR_SHIPPER_MILES=60
TANK_GALLONS=150
MPG=6.5
RESERVE_PERCENT=10
# Truck counts as "stopped" if it moves less than this between 2 checks (~10 min)
STOP_MOVE_MILES=0.3
STOP_CHECKS=2
